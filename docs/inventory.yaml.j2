# ==============================================================================
# SDN  —  Software Defined Networking (опционально)
# ==============================================================================
{% if env.get('ENABLE_SDN') == 'true' %}
sdn:
  zones:
    - name: myzone
      type: simple           # simple | qinq | vxlan | evpn
      comment: "Main SDN zone"
      bridge: vmbr0
      mtu: 1500
      # nodes: [pve1, pve2]  # пусто = все ноды
  vnets:
    - name: myvnet
      zone: myzone
      comment: "Production vnet"
      # tag: 100             # VLAN tag
      # vlan_aware: false
  subnets:
    - cidr: 10.100.0.0/24
      vnet: myvnet
      gateway: 10.100.0.1
      # snat: false

  # ── SDN Applier — применяет конфигурацию SDN после изменений (EXPERIMENTAL)
  # applier:
  #   on_create: true    # применить при создании (default: true)
  #   on_destroy: true   # применить при удалении (default: true)
  #   legacy: false      # true → ApplierLegacy (deprecated)

  # ── SDN Fabrics — автоматическая маршрутизация между узлами кластера ──────
  # fabric_openfabric:
  #   - name: fabric1              # resource_id
  #     ip_prefix: 10.200.0.0/24  # IPv4 prefix для fabric
  #     ip6_prefix: fd00::/64     # IPv6 prefix (опционально)
  #     csnp_interval: 10         # интервал CSNP (опционально)
  #     hello_interval: 1         # интервал hello (опционально)
  #     legacy: false
  #
  # fabric_ospf:
  #   - name: ospf1                # resource_id
  #     area: 0.0.0.0              # OSPF area (IPv4 или 32-bit число)
  #     ip_prefix: 10.201.0.0/24  # IPv4 prefix для fabric
  #     legacy: false

  # ── SDN Fabric Nodes — узлы привязанные к fabric ─────────────────────────
  # fabric_node_openfabric:
  #   - fabric_id: fabric1         # ссылка на fabric_openfabric[].name
  #     node_id: pve1              # имя узла Proxmox
  #     interface_names: [eth1]    # сетевые интерфейсы узла
  #     ip: 10.200.0.1             # IPv4 адрес узла (опционально)
  #     ip6: fd00::1               # IPv6 адрес узла (опционально)
  #     legacy: false
  #   - fabric_id: fabric1
  #     node_id: pve2
  #     interface_names: [eth1]
  #     ip: 10.200.0.2
  #
  # fabric_node_ospf:
  #   - fabric_id: ospf1           # ссылка на fabric_ospf[].name
  #     node_id: pve1
  #     interface_names: [eth1]
  #     ip: 10.201.0.1             # IPv4 адрес узла (обязательно для OSPF)
  #     legacy: false
{% endif %}

# ==============================================================================
# DEFAULTS  —  параметры по умолчанию, сгруппированные по типу ресурса
# ==============================================================================
defaults:

  # ── VM defaults ──────────────────────────────────────────────────────────
  vm:
    node: {{ proxmox_node }}
    bios: seabios              # seabios | ovmf (UEFI)

    # ── CPU ──────────────────────────────────────────────────────────────
    cpu:
      cores: 2
      type: host               # host | kvm64 | penryn | nehalem | ...
      # sockets: 1
      # numa: true
      # affinity: "0-3"        # привязка к ядрам хоста
      # flags: "aes=require;avx=require"
      # hotplugged: 1          # CPU hotplug
      # limit: 100             # макс. % одного ядра
      # units: 1024

    # ── Memory ───────────────────────────────────────────────────────────
    memory:
      dedicated: 2048          # MB
      # floating: 1024         # плавающая память
      # hugepages: true        # huge pages (требует настройки хоста)
      # keep_hugepages: true
      # shared: 512

    # ── Disks ────────────────────────────────────────────────────────────
    disks:
      - size: 32               # GB
        datastore: local-zfs
        # aio: native          # native | writeback | writethrough
        # backup: true
        # cache: writeback     # none | directsync | writethrough | writeback | unsafe
        # discard: "on"
        # file_format: raw     # qcow2 | raw
        # file_id: "local:iso/disk.img"    # импорт существующего образа
        # import_from: "local:iso/disk.img"
        # iothread: true
        # replicate: false
        # serial: "my-disk-001"
        # speed: 500           # MB/s
        # ssd: true

    # ── Agent ────────────────────────────────────────────────────────────
    agent:
      enabled: true
      trim: true
      type: virtio
      # timeout: 30
      # wait_for_ip: true

    # ── Boot ─────────────────────────────────────────────────────────────
    # boot_orders: ["scsi0", "net0"]
    # on_boot: true            # запускать при старте Proxmox
    # started: true            # запустить сразу после создания
    # stop_on_destroy: true

    # ── OVMF / EFI (только если bios: ovmf) ──────────────────────────────
    # efi_disk:
    #   datastore_id: local-zfs
    #   file_format: raw
    #   type: "4m"
    #   pre_enrolled_keys: false

    # ── CD-ROM ───────────────────────────────────────────────────────────
    # cdrom:
    #   interface: ide2
    #   file_id: "local:iso/some.iso"

    # ── Startup order ─────────────────────────────────────────────────────
    # startup:
    #   order: 1
    #   up_delay: 30
    #   down_delay: 30

    # ── Advanced ──────────────────────────────────────────────────────────
    # acpi: true
    # hotplug: "disk,network,cpu"
    # keyboard_layout: "en-us"
    # kvm_arguments: "-object rng-random,id=rng0,filename=/dev/urandom"
    # machine: "q35"
    # pool_id: "production"
    # protection: false
    # scsi_hardware: "virtio-scsi-pci"
    # tablet_device: true
    # tags: ["pulumi", "production"]

    # ── VGA ───────────────────────────────────────────────────────────────
    # vga:
    #   type: std              # std | vmware | qxl | serial0
    #   memory: 16             # MB
    #   clipboard: vnc

    # ── Watchdog ──────────────────────────────────────────────────────────
    # watchdog:
    #   model: i6300esb        # i6300esb | ib700
    #   action: reset          # reset | poweroff | pause | debug
