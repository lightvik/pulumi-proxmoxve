{#
==============================================================================
  INVENTORY.YAML.J2  —  Полный справочник конфигурации
==============================================================================

  Файл является Jinja2-шаблоном. При старте контейнера рендерится в
  /workspace/inventory.yaml, с которым работает Pulumi-стек.

  JINJA2 — КРАТКАЯ СПРАВКА
  ──────────────────────────────────────────────────────────────────────────

  Переменные из окружения (docker run -e VAR=val):
      {{ env.MY_VAR }}
      {{ env.get('MY_VAR', 'default') }}   ← с fallback

  Переменные внутри шаблона:
      {% set my_var = "value" %}
      {{ my_var }}

  Импорт данных из другого YAML-файла (путь относительно inventory.yaml.j2):
      {% set secrets = load_yaml('secrets.yaml') %}
      {{ secrets.api_token }}

  Условия:
      {% if env.get('ENABLE_SDN') == 'true' %}
      sdn:
        ...
      {% endif %}

  Циклы:
      {% for i in range(1, 4) %}
      - name: node{{ i }}
      {% endfor %}

  Комментарии Jinja2 (не попадают в итоговый файл):
      {# это комментарий #}

  Комментарии YAML (попадают в итоговый файл):
      # это комментарий

==============================================================================
#}

{# ── Переменные шаблона ─────────────────────────────────────────────── #}
{# Задайте через docker run -e, или измените значения по умолчанию здесь #}

{% set proxmox_node = env.get('PROXMOX_NODE', 'pve') %}

# ==============================================================================
# PROVIDER
# ==============================================================================
provider:
  endpoint: {{ env.PROXMOX_ENDPOINT }}
  insecure: true
  api_token: {{ env.PROXMOX_TOKEN }}
  # Формат токена: user@realm!token-id=token-secret
  # Пример:        root@pam!pulumi=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==============================================================================
# NETWORK BRIDGES  —  Linux-бриджи на узлах Proxmox (опционально)
# ==============================================================================
# network_bridges:
#   - node: {{ proxmox_node }}
#     name: vmbr1                  # имя интерфейса (vmbr0–vmbr4094)
#     ports: [ens19]               # физические порты бриджа
#     address: 10.10.0.1/24        # IPv4/CIDR (опционально)
#     address6: "fd00::1/64"       # IPv6/CIDR (опционально)
#     gateway: 10.10.0.254         # опционально
#     gateway6: "fd00::1"          # опционально
#     vlan_aware: true             # VLAN-aware бридж
#     autostart: true
#     mtu: 1500
#     comment: "Internal network"
#     # timeout_reload: 100

# ==============================================================================
# NETWORK VLANS  —  VLAN-интерфейсы на узлах Proxmox (опционально)
# ==============================================================================
# network_vlans:
#   # Вариант 1: имя = интерфейс.тег (interface и vlan не нужны)
#   - node: {{ proxmox_node }}
#     name: ens18.10               # VLAN tag берётся из имени
#     address: 192.168.10.1/24
#     autostart: true
#   # Вариант 2: произвольное имя (interface и vlan обязательны)
#   - node: {{ proxmox_node }}
#     name: vlan_mgmt
#     interface: ens18             # raw device
#     vlan: 100                    # VLAN tag
#     address: 172.16.0.1/24
#     gateway: 172.16.0.254
#     autostart: true
#     comment: "Management VLAN"

# ==============================================================================
# NODE DNS  —  настройки DNS на узлах (опционально)
# ==============================================================================
# node_dns:
#   - node: {{ proxmox_node }}
#     servers: [1.1.1.1, 8.8.8.8]
#     domain: example.local        # search domain (опционально)

