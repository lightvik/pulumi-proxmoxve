# VM с clone.vm_id, указывающим на шаблон из этого же инвентаря,
# автоматически получают depends_on.

vms:
  - name: web01
    vmid: 101
    networks:
      - bridge: vmbr0
        # vlan_id: 100
        # firewall: true
        # rate_limit: 1000000000   # бит/сек (1 Gbps)
        # mtu: 1500
        # mac_address: "52:54:00:12:34:56"
