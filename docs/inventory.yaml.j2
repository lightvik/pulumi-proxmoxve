    #         address: "fd00::10/64"
    #         gateway: "fd00::1"

  - name: db01
    vmid: 110
    networks:
      - bridge: vmbr0
    clone:
      vm_id: 9000
    cpu:
      cores: 4
      type: host
    memory:
      dedicated: 8192
      floating: 4096
    disks:
      - size: 50
