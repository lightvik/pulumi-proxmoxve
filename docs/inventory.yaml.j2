# ==============================================================================
# UPLOADS  —  загрузка файлов с локальной машины на Proxmox (опционально)
# ==============================================================================
# Pulumi передаёт файл через API. Для больших ISO используйте downloads: —
# там Proxmox скачивает сам по URL без участия клиентской машины.
#
# content_type: допустимые значения:
#   iso      — ISO-образы (.iso, .img). НЕ подходит для импорта дисков VM.
#   import   — Образы дисков для импорта в VM (.qcow2, .img).
#              Требует включения "Disk image (import)" на хранилище:
#              Datacenter → Storage → <datastore> → Edit → Content.
#   snippets — Произвольные файлы (cloud-init, скрипты и т.п.)
#   vztmpl   — Шаблоны LXC-контейнеров (.tar.gz, .tar.zst)
#
# file_name нужен только когда path — это URL без расширения в имени файла.
#   Провайдер берёт basename из path автоматически, поэтому для локальных
#   файлов с валидным расширением (.qcow2, .img) file_name не указывай.
#
# uploads:
#   # Пример 1: загрузка ISO-образа
#   - name: my-iso
#     node: {{ proxmox_node }}
#     datastore: local
#     content_type: iso
#     source_file:
#       path: /workspace/some.iso
#     overwrite: true
#     timeout_upload: 3600
#
#   # Пример 2: загрузка диска для импорта в VM (qcow2, локальный файл)
#   # После загрузки ссылаться как: import_from: local:import/disk.qcow2
#   - name: my-disk
#     node: {{ proxmox_node }}
#     datastore: local
#     content_type: import
#     source_file:
#       path: /workspace/disk.qcow2
#     overwrite: true
#     timeout_upload: 3600
#
#   # Пример 3: загрузка диска по URL (имя файла берётся из URL)
#   # Если URL не содержит расширения — укажи file_name явно
#   - name: my-disk-from-url
#     node: {{ proxmox_node }}
#     datastore: local
#     content_type: import
#     source_file:
#       path: https://example.com/images/disk        # URL без расширения
#       file_name: disk.img                          # задать явно
#     overwrite: true
#     timeout_upload: 3600
#
#   # Пример 4: загрузка cloud-init сниппета
#   - name: my-cloud-init
#     node: {{ proxmox_node }}
#     datastore: local
#     content_type: snippets
#     source_file:
#       path: /workspace/cloud-init.yaml
#       # checksum: "sha256:abc123..."   # проверка целостности
#       # insecure: false                # пропустить TLS для URL
#     # file_mode: "0644"               # только для root@pam
#     # overwrite: true
#     # timeout_upload: 1800            # секунды

# ==============================================================================
# CLONED_VMS  —  облегчённое клонирование VM (опционально)
# ==============================================================================
# Используйте когда нужно клонировать шаблон без изменения конфигурации.
# Для VM с кастомными CPU/disk/network используйте раздел vms: с clone:.
#
# cloned_vms:
#   - name: app01
#     node: {{ proxmox_node }}
#     legacy: true                 # true → cloned.VmLegacy (рекомендуется)
#     clone:
#       source_vm_id: 9000         # VMID шаблона-источника
#       # source_node_name: pve    # нода шаблона (если отличается от node)
#       # full: true               # полный клон (по умолчанию linked)
#       # target_datastore: local-zfs
#       # target_format: raw       # raw | qcow2
#       # snapshot_name: snap1     # клонировать из снапшота
#       # bandwidth_limit: 100     # MB/s
#       # retries: 3
#       # pool_id: production
#     # description: "Managed by Pulumi"
#     # tags: ["pulumi", "app"]
#     # started: true
#     # stop_on_destroy: true
#     # purge_on_destroy: false
#     # delete_unreferenced_disks_on_destroy: false

