{#
==============================================================================
  INVENTORY.YAML.J2  —  Полный справочник конфигурации
==============================================================================

  Файл является Jinja2-шаблоном. При старте контейнера рендерится в
  /workspace/inventory.yaml, с которым работает Pulumi-стек.

  JINJA2 — КРАТКАЯ СПРАВКА
  ──────────────────────────────────────────────────────────────────────────

  Переменные из окружения (docker run -e VAR=val):
      {{ env.MY_VAR }}
      {{ env.get('MY_VAR', 'default') }}   ← с fallback

  Переменные внутри шаблона:
      {% set my_var = "value" %}
      {{ my_var }}

  Импорт данных из другого YAML-файла (путь относительно inventory.yaml.j2):
      {% set secrets = load_yaml('secrets.yaml') %}
      {{ secrets.api_token }}

  Условия:
      {% if env.get('ENABLE_SDN') == 'true' %}
      sdn:
        ...
      {% endif %}

  Циклы:
      {% for i in range(1, 4) %}
      - name: node{{ i }}
      {% endfor %}

  Комментарии Jinja2 (не попадают в итоговый файл):
      {# это комментарий #}

  Комментарии YAML (попадают в итоговый файл):
      # это комментарий

==============================================================================
#}

{# ── Переменные шаблона ─────────────────────────────────────────────── #}
{# Задайте через docker run -e, или измените значения по умолчанию здесь #}

{% set proxmox_node = env.get('PROXMOX_NODE', 'pve') %}

# ==============================================================================
# PROVIDER
# ==============================================================================
provider:
  endpoint: {{ env.PROXMOX_ENDPOINT }} # Формат:  https://<host-or-ip>:8006
  insecure: true
  api_token: {{ env.PROXMOX_TOKEN }}   # Формат токена: user@realm!token-id=token-secret
  # ssh — требуется в двух случаях:
  #   1. uploads с content_type: snippets или backup (FileLegacy передаёт файл по SSH)
  #   2. containers с полем idmaps (Proxmox API не поддерживает lxc.idmap — пишется по SSH)
  #
  # Приоритет аутентификации: agent > private_key > password
  #
  # ssh:
  #   username: root                                    # SSH-пользователь на ноде Proxmox
  #
  #   # Вариант 1: приватный ключ (PEM, без passphrase)
  #   private_key: {{ env.PROXMOX_SSH_PRIVATE_KEY }}
  #
  #   # Вариант 2: пароль
  #   password: {{ env.PROXMOX_SSH_PASSWORD }}
  #
  #   # Вариант 3: ssh-agent (ключ уже загружен через ssh-add)
  #   agent: true
  #   agent_socket: /tmp/ssh-agent.sock                # по умолчанию берётся из $SSH_AUTH_SOCK
  #   agent_forwarding: false                          # проброс агента дальше по цепочке

